#!/usr/bin/env python3
"""evidence — Evidence Chain CLI (shipped in the evidence-sdlc plugin's bin/, on PATH in sessions).

Lifecycle: change start|status|list|advance|set-tier|release, approve, audit verify, metrics
Traceability: doctor, scan, gaps, export, tracker
"""
import os
import runpy
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
ENGINE = os.path.join(HERE, "..", "scripts", "engine")
TRACE = os.path.join(HERE, "..", "scripts", "cli", "evidence_trace.py")
LIFECYCLE = {"change", "approve", "audit", "metrics"}

sys.path.insert(0, ENGINE)

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in LIFECYCLE:
        import lifecycle
        sys.exit(lifecycle.main(sys.argv[1:]))
    if len(sys.argv) > 1 and sys.argv[1] in ("--version", "version"):
        import state
        print(f"evidence {state.ENGINE_VERSION}")
        sys.exit(0)
    sys.argv[0] = "evidence"
    runpy.run_path(TRACE, run_name="__main__")
