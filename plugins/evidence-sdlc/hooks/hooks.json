{
  "description": "Evidence Chain gates (engine v2). One Python engine makes every decision: plan approval and claims, tier floors, change control, test protection, control-plane protection, secrets, protected pushes, merges, commits and production releases. It fails closed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/engine/hook.sh",
              "pre"
            ],
            "statusMessage": "Evidence Chain gates",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/engine/hook.sh",
              "post"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/engine/hook.sh",
              "prompt"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/preflight.sh"
            ],
            "statusMessage": "Verifying gate environment",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/engine/hook.sh",
              "session-start"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
