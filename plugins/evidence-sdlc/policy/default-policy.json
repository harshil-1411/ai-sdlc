{
  "_comment": "Evidence Chain default gate policy. An organisation policy (EVIDENCE_ORG_POLICY, or evidence-policy.json in the managed-settings directory) may change anything. A repository's .evidence/policy.json may only tighten: lists of protections are unioned, strictness flags are OR-ed, and 'ungated' can only shrink unless the org sets allow_repo_ungated_additions. See docs/policy-reference.md.",
  "key_pattern": "[A-Z][A-Z0-9]+-[0-9]+",
  "non_key_prefixes": [
    "UTF",
    "SHA",
    "ISO",
    "RFC",
    "TLS",
    "SSL",
    "HTTP",
    "CVE",
    "CWE",
    "AES",
    "RSA",
    "MD",
    "X",
    "IPV",
    "WCAG",
    "OWASP",
    "PEP",
    "ES",
    "ECMA",
    "IEC",
    "IEEE",
    "GPL",
    "LGPL",
    "BSD",
    "UTC",
    "GMT",
    "COVID",
    "PCI",
    "SOC",
    "NIST",
    "CC",
    "API",
    "REQ"
  ],
  "change_ticket_pattern": "[A-Z][A-Z0-9]+-[0-9]+",
  "release_approval_pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
  "release_approval_verify_command": "",
  "ungated": [
    "**/*.md",
    "**/*.markdown",
    "**/*.txt",
    "**/*.rst",
    "**/*.adoc",
    "intent/**",
    "plan/**",
    ".evidence/context/**",
    ".evidence/decisions/**",
    "LICENSE*",
    "NOTICE*",
    "CHANGELOG*",
    "AUTHORS*",
    ".gitignore",
    ".evidenceignore"
  ],
  "allow_repo_ungated_additions": false,
  "control_plane": [
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/hooks/**",
    ".evidence/policy.json",
    ".evidence/secrets-allowlist.json",
    ".evidence/changes/*/approval.json",
    ".evidence/changes/*/state.json",
    ".evidence/audit/**",
    "managed-settings.json",
    "**/managed-settings.json",
    ".mcp.json",
    ".claude/agents/**",
    ".evidence/changes/*/violations.json",
    ".evidence/violations/**",
    ".claude/commands/**",
    ".claude/skills/**",
    ".claude/output-styles/**"
  ],
  "user_control_plane": [
    "~/.claude/settings.json",
    "~/.claude/settings.local.json",
    "~/.claude/plugins/**",
    "~/.claude.json",
    "/Library/Application Support/ClaudeCode/**",
    "/etc/claude-code/**"
  ],
  "change_controlled": [
    "**/migrations/**",
    "**/migration/**",
    "**/db/migrate/**",
    "**/alembic/**",
    "**/flyway/**",
    "**/liquibase/**",
    "prisma/schema.prisma",
    "**/schema.sql",
    ".github/workflows/**",
    ".gitlab-ci.yml",
    ".circleci/**",
    "azure-pipelines.yml",
    "Jenkinsfile",
    "bitbucket-pipelines.yml",
    "**/infra/**",
    "**/infrastructure/**",
    "**/terraform/**",
    "**/*.tf",
    "**/*.tfvars",
    "**/helm/**",
    "**/charts/**",
    "**/k8s/**",
    "**/kubernetes/**",
    "**/audit/**",
    "**/signing/**",
    "**/crypto/**",
    "**/validation/**"
  ],
  "tier_floors": {
    "**/auth/**": 3,
    "**/authn/**": 3,
    "**/authz/**": 3,
    "**/auth.*": 3,
    "**/*_auth.*": 3,
    "**/auth_*.*": 3,
    "**/authentication*.*": 3,
    "**/authorization*.*": 3,
    "**/oauth*.*": 3,
    "**/login*.*": 3,
    "**/session*.*": 3,
    "**/permissions*.*": 3,
    "**/crypto/**": 3,
    "**/signing/**": 3,
    "**/audit/**": 3,
    "**/migrations/**": 3,
    "**/db/migrate/**": 3,
    "prisma/schema.prisma": 3,
    "**/payment*/**": 2,
    "**/payment*.*": 2,
    "**/billing/**": 2,
    ".github/workflows/**": 2,
    "**/*.tf": 2,
    "**/helm/**": 2,
    "**/k8s/**": 2
  },
  "test_globs": [
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/spec/**",
    "**/specs/**",
    "**/e2e/**",
    "**/cypress/**",
    "**/playwright/**",
    "**/qa/**",
    "**/test_*.*",
    "**/*_test.*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_spec.*",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*Test.kt",
    "**/*Tests.cs",
    "**/*.cy.*",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/conftest.py",
    "**/pytest.ini",
    "**/tox.ini",
    "**/jest.config.*",
    "**/vitest.config.*",
    "**/playwright.config.*",
    "**/cypress.config.*",
    "**/karma.conf.*",
    "**/.mocharc*",
    "**/phpunit.xml*"
  ],
  "protected_refs": [
    "main",
    "master",
    "trunk",
    "develop",
    "release",
    "release/*",
    "releases/*",
    "hotfix/*",
    "prod",
    "prod/*",
    "production"
  ],
  "deny_agent_merge": true,
  "prod_words": [
    "prod",
    "production",
    "prd",
    "live",
    "prod1",
    "prod2"
  ],
  "treat_unknown_deploy_target_as_production": true,
  "read_only_agents": [
    "codebase-cartographer",
    "security-reviewer",
    "architect",
    "code-reviewer",
    "release-manager",
    "compliance-reviewer",
    "test-designer",
    "stack-surveyor",
    "flake-triage",
    "verifier"
  ],
  "required_agents": {
    "1": [
      "verifier"
    ],
    "2": [
      "verifier",
      "security-reviewer"
    ],
    "3": [
      "verifier",
      "security-reviewer",
      "code-reviewer"
    ]
  },
  "require_review_agents": true,
  "enforce_claims": true,
  "require_agent_trailer": true,
  "deny_tier3_auto_modes": true,
  "tier3_denied_permission_modes": [
    "bypassPermissions",
    "acceptEdits",
    "dontAsk",
    "auto"
  ],
  "deny_opaque_writes": true,
  "scan_secrets": true,
  "deny_git_config_keys": [
    "alias.*",
    "core.hooksPath",
    "core.sshCommand",
    "core.fsmonitor",
    "core.editor",
    "core.pager",
    "credential.*",
    "include.path",
    "includeIf.*",
    "filter.*",
    "diff.*.textconv",
    "sequence.editor",
    "gpg.program"
  ],
  "approval": {
    "mode": "local",
    "github_allowed_approvers": [],
    "github_repo": ""
  },
  "always_gated": [
    "CLAUDE.md",
    "**/CLAUDE.md",
    "**/CLAUDE.local.md",
    "**/REVIEW.md",
    "**/AGENTS.md"
  ],
  "deny_persistence": true,
  "commit_requires_audit": true,
  "deny_background": true
}
