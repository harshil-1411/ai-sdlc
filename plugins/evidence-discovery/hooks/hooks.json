{
  "description": "Makes every session aware of the repository profile, and refuses to let a session invent stack facts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/require-repo-profile.sh"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
