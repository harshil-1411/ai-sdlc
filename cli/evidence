#!/usr/bin/env python3
"""evidence -- derive, gap-check and export the traceability chain from what is
actually committed, instead of assembling it by hand.

Standard library only. No network access. No writes outside the working directory
except the file `evidence export` is asked to write.

Subcommands: doctor, scan, gaps, export. See cli/README.md for a worked example.
"""
import argparse
import csv
import datetime
import io
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

CSV_COLUMNS = [
    "tracker_key", "requirement_id", "requirement_summary", "spec_commit",
    "implementing_commits", "test_case_id", "automated_test", "test_run_id",
    "result", "evidence_link", "risk_tier", "revalidation",
]

DEFAULT_TRACKER_PATTERN = r"[A-Z][A-Z0-9]+-[0-9]+"
DEFAULT_REQ_PATTERN = r"REQ-[A-Za-z0-9]+-[0-9]+"
DEFAULT_TEST_DIR_SEGMENTS = {"tests", "__tests__", "qa"}
DEFAULT_TEST_BASENAME_PATTERNS = [
    re.compile(r"^test_"), re.compile(r"_test\."),
    re.compile(r"\.test\."), re.compile(r"\.spec\."),
]
STALE_DAYS = 183  # ~6 months
KNOWN_PROFILES = ["stack.md", "deployment.md", "toolchain.md", "design-system.md", "compliance.md"]

# A requirement ID counts as covered by a test only when it sits next to something
# that actually declares or tags a test -- not merely anywhere in a file that
# happens to also be shaped like a test file. "A requirement ID appearing in a
# file that also contains the word 'test' is NOT coverage" (see cli/REVIEW-BRIEF.md
# and the item-1 fix that introduced this). This is a heuristic, not a parser: it
# recognises common conventions (pytest, unittest, Jest/Mocha, JUnit-style
# annotations, and an explicit "covers"/"requirement" tag) but is not a substitute
# for real static analysis of an unfamiliar test framework.
TEST_DECL_RE = re.compile(
    r"\bdef\s+test\w*\b|\bit\s*\(|\bdescribe\s*\(|\bclass\s+Test\w*\b|"
    r"\bfunction\s+test\w*\b|@Test\b",
    re.IGNORECASE,
)
TEST_TAG_RE = re.compile(
    r"@covers\b|#\s*covers\b|//\s*covers\b|@requirement\b|#\s*req:|//\s*req:|@pytest\.mark",
    re.IGNORECASE,
)


def find_structural_req_ids(text, req_pattern):
    """Requirement IDs with a genuine structural tie to a test: the ID's own line,
    or the line immediately before or after it, contains a test declaration or an
    explicit tag (a one-line window in each direction covers both a tag comment
    placed above the def it annotates, and a docstring placed below it). Mere
    presence anywhere else in the file is NOT enough on its own."""
    lines = text.splitlines()
    found = set()
    for i, line in enumerate(lines):
        for m in req_pattern.finditer(line):
            window = lines[max(0, i - 1): i + 2]
            context = "\n".join(window)
            if TEST_DECL_RE.search(context) or TEST_TAG_RE.search(context):
                found.add(m.group(0))
    return found


