# gaps
# ---------------------------------------------------------------------------

def csv_row_corroborated(root, row):
    """A traceability.csv row naming a requirement and a test_case_id is only
    real evidence if that claim can be independently checked against something
    other than the CSV itself -- otherwise it is a description someone typed, not
    a link (evidence-package's own rule: "Evidence is a link... never a
    description"). Requires: automated_test names at least one file that exists,
    and that file's content contains the test_case_id or the requirement_id
    verbatim. A non-empty test_case_id with no corroborating file is an
    assertion, not coverage."""
    test_case_id = (row.get("test_case_id") or "").strip()
    rid = (row.get("requirement_id") or "").strip()
    automated_test = (row.get("automated_test") or "").strip()
    if not test_case_id or not rid or not automated_test:
        return False
    for rel in (p.strip() for p in automated_test.split(",")):
        if not rel:
            continue
        p = root / rel
        if not p.is_file():
            continue
        text = read_text(p)
        if text is None:
            continue
        if test_case_id in text or rid in text:
            return True
    return False


def compute_gaps(root, graph):
    covered_req_ids = set()
    for t in graph["tests"]:
        covered_req_ids |= t["req_ids"]

    csv_claims = {}  # req_id -> row, for rows that name both a req and a test_case_id
    for row in graph["traceability_rows"]:
        rid = row.get("requirement_id")
        if rid and row.get("test_case_id"):
            csv_claims[rid] = row
            if csv_row_corroborated(root, row):
                covered_req_ids.add(rid)

    no_coverage = []
    for rid in sorted(set(graph["requirements"]) - covered_req_ids):
        if rid in csv_claims:
            row = csv_claims[rid]
            automated_test = row.get("automated_test") or "(empty)"
            no_coverage.append(
                f"{rid} (validation/traceability.csv claims test_case_id="
                f"'{row.get('test_case_id')}' in automated_test='{automated_test}', "
                f"but that claim could not be independently verified against the "
                f"named file's actual content -- treated as uncovered, not assumed correct)"
            )
        else:
            no_coverage.append(rid)

    known_req_ids = set(graph["requirements"])
    orphaned = sorted({
        f"{t['path']} -> {rid}"
        for t in graph["tests"] for rid in t["req_ids"]
        if rid not in known_req_ids
    })

    untraced = [c["sha"] + " " + c["subject"] for c in graph["commits"] if not c["tracker_keys"]]

    unproven = []
    for row in graph["traceability_rows"]:
        result = (row.get("result") or "").strip()
        if not result.upper().startswith("PASS"):
            unproven.append(f"{row.get('requirement_id', '?')}: result={result or '(none)'}")

    return {
        "NO COVERAGE": no_coverage,
        "ORPHANED": orphaned,
        "UNTRACED": untraced,
        "UNPROVEN": unproven,
    }


def _print_gaps(label_prefix, gaps):
    any_no_coverage = False
    for label in ["NO COVERAGE", "ORPHANED", "UNTRACED", "UNPROVEN"]:
        items = gaps[label]
        print(f"{label_prefix}{label} ({len(items)})")
        if not items:
            print("  none")
        else:
            for i in items[:50]:
                print(f"  - {i}")
            if len(items) > 50:
                print(f"  ... and {len(items) - 50} more")
        print()
        if label == "NO COVERAGE" and items:
            any_no_coverage = True
    return any_no_coverage


def assessment_basis_line(root, graph):
    req_source = (
        "an issue tracker (unavailable locally, per requirements_source: tracker)"
        if graph["requirements_source"] == "tracker"
        else f"{graph['spec_files_scanned']} spec file(s)"
    )
    return (
        f"Assessment basis: {len(graph['requirements'])} requirements from {req_source}, "
        f"{len(graph['tests'])} tests parsed from {graph['test_source_desc'] or 'test-location conventions'}, "
        f"{graph['skipped_files']} unparseable file(s) skipped."
    )


def cmd_gaps(root, args):
    if getattr(args, "repos", None):
        repos = find_sibling_repos(args.repos)
        if not repos:
            print(f"No sibling git repositories found under {args.repos}.")
            return 0
        print("evidence gaps --repos")
        print("=" * 60)
        graphs = {}
        any_no_coverage = False
        for r in repos:
            adapter, _ = load_adapter(r)
            graphs[r.name] = build_graph(r, adapter)
            print(f"--- {r.name} ---")
            print(assessment_basis_line(r, graphs[r.name]))
            if _print_gaps("", compute_gaps(r, graphs[r.name])):
                any_no_coverage = True

        # Cross-repo: a requirement referenced in more than one repo's requirements
        # or traceability rows, covered in some but not covered in others. Uses the
        # same corroboration rule as the single-repo path -- a CSV claim only
        # counts if the named test file exists and contains the ID.
        roots_by_name = {r.name: r for r in repos}
        req_repos = {}   # req_id -> {repo_name: covered_bool}
        for name, g in graphs.items():
            covered = set()
            for t in g["tests"]:
                covered |= t["req_ids"]
            for row in g["traceability_rows"]:
                if row.get("requirement_id") and row.get("test_case_id") and csv_row_corroborated(roots_by_name[name], row):
                    covered.add(row["requirement_id"])
            referenced = set(g["requirements"]) | {
                row.get("requirement_id") for row in g["traceability_rows"] if row.get("requirement_id")
            }
            for rid in referenced:
                req_repos.setdefault(rid, {})[name] = rid in covered

        cross_repo_gaps = []
        for rid, per_repo in sorted(req_repos.items()):
            if len(per_repo) < 2:
                continue
            covered_in = sorted(n for n, ok in per_repo.items() if ok)
            missing_in = sorted(n for n, ok in per_repo.items() if not ok)
            if covered_in and missing_in:
                cross_repo_gaps.append(f"{rid}: covered in {', '.join(covered_in)}; NOT covered in {', '.join(missing_in)}")

        print("--- CROSS-REPO COVERAGE GAPS ---")
        print(f"({len(cross_repo_gaps)})")
        if not cross_repo_gaps:
            print("  none")
        else:
            for i in cross_repo_gaps:
                print(f"  - {i}")

        if any_no_coverage or cross_repo_gaps:
            print()
            print("RESULT: coverage gap(s) exist across the participating repositories.")
            return 1
        print()
        print("RESULT: no coverage gaps.")
        return 0

    adapter, _ = load_adapter(root)
    graph = build_graph(root, adapter)

    print("evidence gaps")
    print("=" * 60)

    all_known_reqs = set(graph["requirements"]) | {
        row.get("requirement_id") for row in graph["traceability_rows"] if row.get("requirement_id")
    }
    if not all_known_reqs:
        print("No requirements found.")
        print(f"Scanned: {graph['spec_files_scanned']} spec file(s), {len(graph['commits'])} commits, "
              f"{len(graph['tests'])} test files.")
        print("Nothing to assess -- this is not a coverage result.")
        print("If this repository should have requirement IDs, check .evidence/adapter.yml.")
        return 2

    print(assessment_basis_line(root, graph))
    print()
    gaps = compute_gaps(root, graph)
    any_no_coverage = _print_gaps("", gaps)

    if any_no_coverage:
        print("RESULT: NO COVERAGE items exist -- this must block a release gate.")
        return 1
    print("RESULT: no NO COVERAGE items.")
    return 0


# ---------------------------------------------------------------------------
# export
# ---------------------------------------------------------------------------

def cmd_export(root, args):
    adapter, _ = load_adapter(root)
    graph = build_graph(root, adapter)

    existing = {}
    order = []
    csv_path = root / "validation" / "traceability.csv"
    if csv_path.exists():
        text = read_text(csv_path) or ""
        reader = csv.DictReader(io.StringIO(text))
        for row in reader:
            rid = row.get("requirement_id", "")
            existing[rid] = row
            order.append(rid)

    touched = set(graph["requirements"])
    for req_id, info in graph["requirements"].items():
        row = existing.get(req_id, {col: "" for col in CSV_COLUMNS})
        row["requirement_id"] = req_id
        row["requirement_summary"] = info["summary"] or row.get("requirement_summary", "")
        row["spec_commit"] = info["spec_commit"] or row.get("spec_commit", "")
        row["tracker_key"] = info["tracker_key"] or row.get("tracker_key", "")
        matching_tests = [t for t in graph["tests"] if req_id in t["req_ids"]]
        if matching_tests:
            row["automated_test"] = ", ".join(sorted(t["path"] for t in matching_tests))
        # Covered only with a structural test match OR a CSV claim that is itself
        # independently corroborated against the file it names -- a bare
        # test_case_id with nothing behind it is not evidence (see item-1 fix).
        covered = bool(matching_tests) or csv_row_corroborated(root, row)
        if not covered:
            reason = "NO COVERAGE"
            if (row.get("test_case_id") or "").strip():
                reason = (f"NO COVERAGE (test_case_id '{row['test_case_id']}' in "
                          f"automated_test '{row.get('automated_test') or '(empty)'}' could not be "
                          f"independently verified)")
            row["evidence_link"] = reason
        elif not row.get("evidence_link"):
            row["evidence_link"] = "see automated_test / spec_commit"
        existing[req_id] = row
        if req_id not in order:
            order.append(req_id)

    rows = [existing[rid] for rid in order]

    basis = assessment_basis_line(root, graph)

    fmt = args.format
    if fmt == "csv":
        # The basis line is NEVER written into the CSV itself -- a leading comment
        # would be mis-parsed as the header row by csv.DictReader on the very next
        # `evidence scan`/`export` (both re-read validation/traceability.csv). It
        # goes to stderr instead, so `evidence export --format csv > file.csv`
        # still redirects clean, re-parseable CSV.
        buf = io.StringIO()
        writer = csv.DictWriter(buf, fieldnames=CSV_COLUMNS, extrasaction="ignore")
        writer.writeheader()
        for row in rows:
            writer.writerow({col: row.get(col, "") for col in CSV_COLUMNS})
        output = buf.getvalue()
    else:
        lines = [basis, "", "| " + " | ".join(CSV_COLUMNS) + " |", "| " + " | ".join(["---"] * len(CSV_COLUMNS)) + " |"]
        for row in rows:
            lines.append("| " + " | ".join((row.get(col, "") or "").replace("|", "/") for col in CSV_COLUMNS) + " |")
        output = "\n".join(lines) + "\n"

    if fmt == "csv":
        print(basis, file=sys.stderr)

    if args.write:
        out_path = root / "validation" / f"traceability.{'csv' if fmt == 'csv' else 'md'}"
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(output, encoding="utf-8")
        print(f"Wrote {out_path.relative_to(root)} ({len(rows)} rows, {len(touched)} touched this scan).")
    else:
        sys.stdout.write(output)
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(prog="evidence", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="preflight checks for this repository's gate environment")
    p_scan = sub.add_parser("scan", help="build and report the traceability graph")
    p_scan.add_argument("--repos", metavar="DIR",
                         help="walk sibling repositories under DIR and join their chains on the parent tracker key")
    p_gaps = sub.add_parser("gaps", help="report coverage gaps; non-zero exit on NO COVERAGE")
    p_gaps.add_argument("--repos", metavar="DIR",
                         help="also report requirements with coverage in some sibling repositories but not others")
    p_export = sub.add_parser("export", help="write the traceability matrix")
    p_export.add_argument("--format", choices=["csv", "md"], default="csv")
    p_export.add_argument("--write", action="store_true",
                           help="write to validation/traceability.<ext> instead of stdout")

    args = parser.parse_args()
    root = find_repo_root()

    if args.command == "doctor":
        return cmd_doctor(root, args)
    if args.command == "scan":
        return cmd_scan(root, args)
    if args.command == "gaps":
        return cmd_gaps(root, args)
    if args.command == "export":
        return cmd_export(root, args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
