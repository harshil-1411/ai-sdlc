#!/usr/bin/env python3
"""Shim: the `evidence` CLI now ships inside the evidence-sdlc plugin
(plugins/evidence-sdlc/bin/evidence, on PATH in Claude Code sessions).
This path is kept so existing docs, scripts and CI keep working."""
import os
import runpy
import sys

TARGET = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "plugins", "evidence-sdlc", "bin", "evidence")
sys.argv[0] = TARGET
runpy.run_path(TARGET, run_name="__main__")
